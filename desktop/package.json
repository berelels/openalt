{
  "name": "@openalt/desktop",
  "version": "0.1.1",
  "description": "OpenAlt: your Android phone or tablet as a second monitor, a mirror of your PC or a game screen.",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.renderer.json && tsc -p tsconfig.main.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "start": "npm run build && electron .",
    "capture": "npm run build && electron scripts/capture.mjs",
    "test": "node --test",
    "dist": "npm run build -w @openalt/core --prefix .. && npm run build && electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "material-symbols": "^0.48.0",
    "@openalt/core": "0.0.1"
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "main": "dist/main/main.js",
  "author": {
    "name": "Catta Studios",
    "email": "gabrieldiasnevess@outlook.com",
    "url": "https://cattastudios.com.br/openalt/"
  },
  "homepage": "https://cattastudios.com.br/openalt/"
}
