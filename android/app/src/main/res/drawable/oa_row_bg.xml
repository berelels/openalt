<?xml version="1.0" encoding="utf-8"?>
<!-- OpenAlt: cartão de uma opção das Configurações; foco = anel escuro -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="@color/oa_surface" /><stroke android:width="3dp" android:color="@color/oa_text" /><corners android:radius="22dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/oa_border" /><corners android:radius="22dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/oa_surface" /><stroke android:width="1dp" android:color="@color/oa_border" /><corners android:radius="22dp" /></shape>
    </item>
</selector>
