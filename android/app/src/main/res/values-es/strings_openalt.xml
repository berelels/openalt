    <!-- Problemas con el QR -->
    <string name="openalt_qr_not_openalt">Este QR no es de OpenAlt. En el PC, abre OpenAlt y toca Vincular.</string>
    <string name="openalt_qr_version">Este QR lo hizo otra versión de OpenAlt. Actualiza la app del celular y la del PC.</string>
    <string name="openalt_qr_invalid">Este QR está incompleto o dañado. Genera otro en el PC.</string>
    <string name="openalt_qr_expired">Este QR venció (dura 2 minutos). En el PC, genera uno nuevo y escanéalo otra vez.\n\nSi el QR acaba de aparecer, revisa que la fecha y la hora del dispositivo sean correctas.</string>

    <!-- Problemas al vincular -->
    <string name="openalt_pair_unreachable">No encontré el PC en ninguna dirección del QR (%1$s).\n\nRevisa que OpenAlt esté encendido en el PC y que el dispositivo esté en la misma red Wi-Fi. Fuera de casa, los dos tienen que estar en Tailscale.</string>
    <string name="openalt_pair_cert_mismatch">El PC que respondió no es el del QR (el certificado no coincide). Por seguridad, se canceló la vinculación.\n\nGenera otro QR en el PC e inténtalo de nuevo.</string>
    <string name="openalt_pair_pin_wrong">El PC rechazó el código. Genera un QR nuevo en el PC e inténtalo de nuevo.</string>
    <string name="openalt_pair_failed">La vinculación no funcionó. Genera un QR nuevo en el PC e inténtalo de nuevo.</string>
    <string name="openalt_pair_in_progress">Otro dispositivo se está vinculando con este PC ahora. Espera un poco e inténtalo de nuevo.</string>
    <string name="openalt_pair_timeout">El PC no confirmó a tiempo. El QR puede haber vencido o ya se usó: genera otro en el PC.</string>
    <string name="openalt_pair_error">Error al hablar con el PC: %1$s</string>
    <string name="openalt_pair_pending_elsewhere">El PC ya tiene una solicitud de vinculación de este dispositivo sin terminar, probablemente de la app Moonlight original. Ciérrala allí (o espera a que caduque) y, en el PC, toca Apagar y Encender en OpenAlt y escanea el QR nuevo.</string>
    <string name="openalt_pair_save_failed">Se vinculó, pero no pude guardar el PC en la lista. Intenta agregarlo de nuevo con el QR.</string>
    <string name="openalt_no_camera">Este dispositivo no tiene cámara para leer el QR. Agrega el PC con el botón +, usando su dirección.</string>

