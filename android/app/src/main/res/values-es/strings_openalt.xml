    <string name="openalt_pair_button">Vincular con QR</string>
    <string name="openalt_pair_button_description">Vincular con un PC escaneando el QR de OpenAlt</string>
    <string name="openalt_pair_intro">En el PC, abre OpenAlt, toca Encender y luego Vincular. Apunta la cámara al QR que aparece en la pantalla.</string>
