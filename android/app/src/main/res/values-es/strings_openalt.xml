    <!-- Acerca de -->
    <string name="openalt_about_title">Acerca de OpenAlt</string>
    <string name="openalt_about_text">OpenAlt, de Catta Studios: tu celular o tableta como otra pantalla del PC.\n\nBasado en Moonlight para Android (moonlight-stream.org), de Cameron Gutman y colaboradores, y hecho para Sunshine (LizardByte). Software libre bajo la licencia GPL-3.0.\n\nLector de QR: ZXing y zxing-android-embedded (Apache-2.0).</string>
