<?xml version="1.0" encoding="utf-8"?>
<!-- OpenAlt: uma opção das Configurações (ícone, nome, o que faz, valor; - e + para números) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/oa_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="84dp"
    android:orientation="horizontal"
    android:paddingLeft="18dp"
    android:paddingTop="12dp"
    android:paddingRight="18dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/oaRowIcon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/oa_icon_tile_bg"
        android:importantForAccessibility="no"
        android:padding="13dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/oaRowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/oa_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/oaRowHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/oa_text"
            android:alpha="0.8"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/oaRowMinus"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/oa_icon_btn_bg"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/oa_ic_minus"
        android:visibility="gone" />

    <TextView
        android:id="@+id/oaRowValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/oa_value_pill_bg"
        android:maxWidth="260dp"
        android:paddingLeft="16dp"
        android:paddingTop="9dp"
        android:paddingRight="16dp"
        android:paddingBottom="9dp"
        android:textColor="@color/oa_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/oaRowPlus"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/oa_icon_btn_bg"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/oa_ic_plus"
        android:visibility="gone" />
</LinearLayout>
