<?xml version="1.0" encoding="utf-8"?>
<!-- OpenAlt: launcher (HomeActivity). Deitado: cartões em fila, rolando para o lado. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oa_bg">

    <LinearLayout
        android:id="@+id/oaHomeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="40dp"
        android:paddingTop="24dp"
        android:paddingRight="40dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="30dp"
                android:layout_marginRight="8dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/oa_logo" />

            <dev.cattastudios.openalt.WordmarkView
                style="@style/OpenAlt.Wordmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/oaNetwork"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/oa_card_bg"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:fontFamily="monospace"
                android:textAllCaps="true"
                android:textColor="@color/oa_text"
                android:textSize="13sp"
                android:visibility="visible" />

            <ImageButton
                android:id="@+id/oaSettings"
                style="@style/OpenAlt.IconButton"
                android:contentDescription="@string/openalt_home_settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="@string/openalt_home_your_pcs"
            android:textAllCaps="true"
            android:textColor="@color/oa_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:id="@+id/oaCardsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/oaCards"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/oaTouchHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/openalt_home_touch_hint"
                android:textColor="@color/oa_text"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/oaPadHints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- a abertura (a mesma do app do PC) fica por cima até a cortina subir -->
    <WebView
        android:id="@+id/oaIntro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
