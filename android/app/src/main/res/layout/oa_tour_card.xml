<?xml version="1.0" encoding="utf-8"?>
<!-- OpenAlt: o cartão do tour guiado (TourOverlay). O padding da direita e de baixo inclui a sombra. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/oa_tour_card_bg"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="18dp"
    android:paddingRight="26dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/oaTourCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="@color/oa_accent_text"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/oaTourTitle"
        style="@style/OpenAlt.CardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/oa_text" />

    <TextView
        android:id="@+id/oaTourText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/oa_text"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/oaTourSkip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/oa_focus_ring"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:text="@string/openalt_tour_skip"
            android:textAllCaps="false"
            android:textColor="@color/oa_text"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/oaTourBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/oa_icon_btn_bg"
            android:minWidth="0dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/openalt_tour_back"
            android:textAllCaps="false"
            android:textColor="@color/oa_text"
            android:textSize="15sp" />

        <Button
            android:id="@+id/oaTourNext"
            style="@style/OpenAlt.PillButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minHeight="48dp"
            android:minWidth="0dp"
            android:text="@string/openalt_tour_next"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
