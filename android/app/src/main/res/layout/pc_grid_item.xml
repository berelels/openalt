<?xml version="1.0" encoding="utf-8"?>
<!-- OpenAlt: cada PC é um cartão, como os cartões do app do PC -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/oa_card_bg"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">
        <RelativeLayout
            android:id="@+id/grid_image_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true">
            <ImageView
                android:id="@+id/grid_image"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_centerHorizontal="true"
                android:tint="@color/oa_text"
                android:importantForAccessibility="no" />
            <ImageView
                android:id="@+id/grid_overlay"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="22dp" />
            <ProgressBar
                android:id="@+id/grid_spinner"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="22dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/oa_accent_text" />
        </RelativeLayout>
        <TextView
            android:id="@+id/grid_text"
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/grid_image_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/oa_text"
            android:textSize="18sp" />
    </RelativeLayout>
</RelativeLayout>
