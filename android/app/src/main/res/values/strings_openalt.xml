<!-- OpenAlt texts. This default ("values") is English, used for any language without a translation;
     values-pt is Portuguese and values-es is Spanish. Keep the three in sync. -->
<resources>
    <string name="openalt_app_name" translatable="false">OpenAlt</string>

    <!-- Home screen -->
    <string name="openalt_home_subtitle">Your phone or tablet as a PC screen</string>
    <string name="openalt_searching_short">Looking for PCs on the network…</string>
    <string name="openalt_settings">Settings</string>
    <string name="openalt_help">Help</string>
    <string name="openalt_add_pc">Add a PC by address</string>

    <!-- Pair screen -->
    <string name="openalt_pair_title">Pair with the PC</string>
    <string name="openalt_pair_button">Pair with QR</string>
    <string name="openalt_pair_button_description">Pair with a PC by scanning the OpenAlt QR code</string>
    <string name="openalt_pair_intro">On the PC, open OpenAlt, tap Turn on and then Pair. Point the camera at the QR code on the screen.</string>
    <string name="openalt_pair_scan">Scan the QR code</string>
    <string name="openalt_pair_scan_again">Scan again</string>
    <string name="openalt_pair_cancel">Cancel</string>
    <string name="openalt_pair_done">Done</string>
    <string name="openalt_scan_prompt">Point at the QR code on the OpenAlt screen on the PC</string>
    <string name="openalt_pair_searching">Looking for %1$s…</string>
    <string name="openalt_pair_trying">Trying %1$s (%2$d of %3$d)</string>
    <string name="openalt_pair_pairing">Pairing with %1$s… The PC confirms by itself; no need to type anything.</string>
    <string name="openalt_pair_saving">Saving the PC…</string>
    <string name="openalt_pair_success">Paired with %1$s! Tap it in the list to connect.</string>
    <string name="openalt_pc_unnamed">the PC</string>

    <!-- QR problems -->
    <string name="openalt_qr_not_openalt">This QR code is not from OpenAlt. On the PC, open OpenAlt and tap Pair.</string>
    <string name="openalt_qr_version">This QR code was made by another version of OpenAlt. Update the app on the phone and on the PC.</string>
    <string name="openalt_qr_invalid">This QR code is incomplete or damaged. Generate another one on the PC.</string>
    <string name="openalt_qr_expired">This QR code has expired (it lasts 2 minutes). On the PC, generate a new one and scan it again.\n\nIf the code just appeared, check that the device\'s date and time are correct.</string>

    <!-- Pairing problems -->
    <string name="openalt_pair_unreachable">Could not reach the PC at any address in the QR code (%1$s).\n\nCheck that OpenAlt is on on the PC and that the device is on the same Wi-Fi network. Away from home, both need to be on Tailscale.</string>
    <string name="openalt_pair_cert_mismatch">The PC that answered is not the one in the QR code (the certificate does not match). For safety, pairing was cancelled.\n\nGenerate another QR code on the PC and try again.</string>
    <string name="openalt_pair_pin_wrong">The PC rejected the code. Generate a new QR code on the PC and try again.</string>
    <string name="openalt_pair_failed">Pairing did not work. Generate a new QR code on the PC and try again.</string>
    <string name="openalt_pair_in_progress">Another device is pairing with this PC right now. Wait a moment and try again.</string>
    <string name="openalt_pair_timeout">The PC did not confirm in time. The QR code may have expired or already been used: generate another one on the PC.</string>
    <string name="openalt_pair_error">Error talking to the PC: %1$s</string>
    <string name="openalt_pair_pending_elsewhere">The PC already has an unfinished pairing request from this device, probably from the original Moonlight app. Close it there (or wait for it to expire), then on the PC tap Turn off and Turn on in OpenAlt and scan the new QR code.</string>
    <string name="openalt_pair_save_failed">Paired, but could not save the PC to the list. Try adding it again with the QR code.</string>
    <string name="openalt_no_camera">This device has no camera to read the QR code. Add the PC with the + button, using its address.</string>

    <!-- Connect straight to the OpenAlt app on the PC -->
    <string name="openalt_connecting">Connecting to %1$s…</string>
    <string name="openalt_app_missing">This PC does not have the OpenAlt app in Sunshine. Showing the available apps.</string>

    <!-- About -->
    <string name="openalt_about_title">About OpenAlt</string>
    <string name="openalt_about_text">OpenAlt, by Catta Studios: your phone or tablet as another PC screen.\n\nBased on Moonlight for Android (moonlight-stream.org), by Cameron Gutman and contributors, and made for Sunshine (LizardByte). Free software under the GPL-3.0 license.\n\nQR reader: ZXing and zxing-android-embedded (Apache-2.0).</string>
